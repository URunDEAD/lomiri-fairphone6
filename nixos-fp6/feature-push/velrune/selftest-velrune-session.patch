+/// The Velrune session replaces Lomiri on the panel (velrune-session.service, which
+/// conflicts with display-manager.service). Lomiri's own processes are then absent
+/// by design, so their checks are skipped instead of failed.
+fn velrune_session_active() -> bool {
+    matches!(
+        capture("systemctl", &["is-active", "velrune-session.service"]),
+        Ok(state) if state.trim() == "active"
+    )
+}
